<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome Aboard</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family:
          'Inter',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      table {
        border-collapse: collapse;
      }
      .btn-primary:hover {
        background-color: #1e293b !important;
        border-color: #1e293b !important;
      }
      @media only screen and (max-width: 600px) {
        .container-table {
          width: 100% !important;
          margin: 0 auto !important;
          border-radius: 0 !important;
        }
        .content-cell {
          padding: 30px 20px !important;
        }
        .logo-img {
          max-height: 40px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f8fafc; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='background-color: #f8fafc; min-height: 100vh; padding: 30px 0;'
    >
      <tr>
        <td align='center' style='padding: 10px;'>
          <table
            role='presentation'
            cellpadding='0'
            cellspacing='0'
            class='container-table'
            width='100%'
            style='max-width: 580px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(10, 17, 40, 0.05); border: 1px solid #e2e8f0;'
          >
            <tr>
              <td
                align='center'
                style='background-color: #ffffff; padding: 35px 24px; border-bottom: 1px solid #e2e8f0;'
              >
                <img
                  src='{{logoUrl}}'
                  alt='{{appName}} Logo'
                  class='logo-img'
                  style='display: block; max-height: 48px; width: auto; border: 0;'
                />
              </td>
            </tr>
            <tr>
              <td class='content-cell' style='padding: 45px 50px; background-color: #ffffff;'>
                <table role='presentation' cellpadding='0' cellspacing='0' width='100%'>
                  <tr>
                    <td>
                      <h1
                        style='margin-top: 0; margin-bottom: 20px; color: #0f172a; font-size: 22px; font-weight: 700; line-height: 1.3;'
                      >
                        Welcome to
                        {{appName}}
                      </h1>
                      <p
                        style='margin-top: 0; margin-bottom: 12px; color: #1e293b; font-size: 16px; font-weight: 600;'
                      >
                        Hi
                        {{name}},
                      </p>
                      <p
                        style='margin-top: 0; margin-bottom: 28px; color: #475569; font-size: 15px; line-height: 1.6;'
                      >
                        You have been invited to join
                        {{appName}}
                        as
                        {{#if role}}<strong>{{role}}</strong>{{else}}a member{{/if}}. Click the
                        button below to log in and get started.
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td align='center' style='padding: 10px 0 35px 0;'>
                      <table
                        role='presentation'
                        cellpadding='0'
                        cellspacing='0'
                        style='border-collapse: separate;'
                      >
                        <tr>
                          <td align='center' style='border-radius: 6px; background-color: #0a1128;'>
                            <a
                              href='{{loginLink}}'
                              class='btn-primary'
                              target='_blank'
                              style='display: inline-block; padding: 14px 30px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 6px; border: 1px solid #0a1128;'
                            >
                              Accept Invitation & Log In
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <p
                        style='margin-top: 10px; margin-bottom: 4px; color: #1e293b; font-size: 15px; font-weight: 600;'
                      >
                        Thanks,
                      </p>
                      <p
                        style='margin-top: 0; margin-bottom: 0; color: #475569; font-size: 15px; font-weight: 500;'
                      >
                        {{appName}}
                        Team
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                align='center'
                style='background-color: #f8fafc; padding: 24px 20px; border-top: 1px solid #edf2f7;'
              >
                <p style='margin: 0 0 6px 0; color: #64748b; font-size: 11px; line-height: 1.4;'>
                  This is an automated invitation notification.
                </p>
                <p style='margin: 0; color: #64748b; font-size: 11px; line-height: 1.4;'>
                  &copy; 2026
                  {{appName}}. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>