PORT=4000
NODE_ENV=development
HOST_URL=http://localhost:4000
DATABASE_URL="postgresql://postgres:ashish123@localhost:5432/box_cricket_db?schema=public"
JWT_SECRET=secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=1d
WHITE_LIST_URLS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,https://example.com,https://api.example.com,https://app.example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER_NAME="The Riverside Cricket Box"
DISABLE_EMAIL=false

# File Storage Configuration (USE_S3=false for Local, USE_S3=true for AWS S3)
USE_S3=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Box cricket
DEFAULT_VENUE_ID=arena
PUBLIC_SITE_URL=http://localhost:5173
# Admin panel (reset-password links point here; defaults to PUBLIC_SITE_URL/admin)
ADMIN_PANEL_URL=http://localhost:5173/admin
# First admin account created by `npm run db:seed` (change the password after first login)
ADMIN_SEED_NAME="Venue Admin"
ADMIN_SEED_EMAIL=admin@riverside.example
ADMIN_SEED_PASSWORD=Admin@12345

# Razorpay (leave empty to run payments in mock mode outside production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_VPA=
UPI_PAYEE_NAME="The Riverside Cricket Box"

# SMS (SMS_PROVIDER=msg91 | twilio | console)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_CUSTOMER=
MSG91_TEMPLATE_ADMIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_NOTIFY_PHONE=
